+    var ch = f.charAt(i);
+    if (ch === '"' || ch === "'") {
+      if (buf) { parts.push([buf, false]); buf = ''; }
+      var j = i + 1;
+      while (j < f.length) {
+        if (f.charAt(j) === ch) { if (f.charAt(j + 1) === ch) { j += 2; continue; } break; }
+        j++;
+      }
+      parts.push([f.slice(i, j + 1), true]);
+      i = j + 1;
+    } else { buf += ch; i++; }
+  }
+  if (buf) parts.push([buf, false]);
+  return parts;
+}
