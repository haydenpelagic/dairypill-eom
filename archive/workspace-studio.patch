diff --git a/test/studio.test.js b/test/studio.test.js
new file mode 100644
index 0000000..e4362c2
--- /dev/null
+++ b/test/studio.test.js
@@ -0,0 +1,175 @@
+'use strict';
+// Rule 1.5: the Workspace Studio steps. Runs the real Studio callbacks against the in-memory
+// Drive: check → queue → background build → result email, plus every way it can refuse.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('fs');
+const path = require('path');
+const vm = require('vm');
+const { createGas } = require('./gasMock');
+const { sampleRaw, csv } = require('./fixtures/sampleMonth');
+
+function load(gas) {
+  const ctx = vm.createContext(gas.sandbox);
+  for (const f of ['Config.gs', 'Logic.gs', 'Sheets.gs', 'Main.gs', 'Studio.gs']) {
+    vm.runInContext(fs.readFileSync(path.join(__dirname, '..', 'src', f), 'utf8'), ctx, { filename: f });
+  }
+  return ctx;
+}
+
+function putMonthFiles(folder, raw) {
+  folder.createFile('DY_Stock_Snapshot_Palisades (12).csv', csv(raw.adsEnd));
+  folder.createFile('177349020748.csv', csv(raw.ledger));
+  folder.createFile('BusinessReport.csv', csv(raw.biz));
+  folder.createFile('orders_export.csv', csv(raw.shopify));
+  folder.createFile('manual orders.csv', csv(raw.manual));
+  folder.createFile('ProductionLabor.DY.xls', raw.woHtml, 'application/vnd.ms-excel');
+  const b = folder.createFolder('Starting Balances');
+  b.createFile('DY_Stock_Snapshot_Palisades (11).csv', csv(raw.adsStart));
+  b.createFile('ledger end.csv', csv(raw.amzStart));
+}
+
+/** A fresh Drive with September ready to build (first run). */
+function setup() {
+  const gas = createGas();
+  const ctx = load(gas);
+  const parent = gas.root.createFolder('EOM Reports');
+  const sep = parent.createFolder('September 2026');
+  const raw = sampleRaw(2026, 8);
+  putMonthFiles(sep, raw);
+  gas.spreadsheetWithId(ctx.CONFIG.BOM_SOURCE.spreadsheetId, 'Ops Hub', null, { bom: raw.bomValues.map((r) => ['', '', '', ''].concat(r)) });
+  gas.spreadsheetWithId(ctx.CONFIG.BOOTSTRAP_WORKBOOK_ID, 'Sept hand-built', null, {
+    COGS: [raw.cogsHeader].concat(raw.cogsRows),
+    Prepaid: [['Prepaid POs', 'Invoice', 'SKU']]
+  });
+  ctx.CONFIG.PARENT_FOLDER_ID = parent.getId();
+  return { gas, ctx, parent, sep };
+}
+
+const event = (month) => ({ workflow: { actionInvocation: { inputs: month === undefined ? {} : { month: { stringValues: [month] } } } } });
+const outputs = (res) => res.hostAppAction.workflowAction.returnOutputVariablesAction;
+const error = (res) => res.hostAppAction.workflowAction.returnElementErrorAction;
+const findFile = (folder, name) => { const it = folder.getFilesByName(name); return it.hasNext() ? it.next() : null; };
+
+test('Build DairyPill EOM: checks, queues, builds in the background, emails the link', () => {
+  const { gas, ctx, sep } = setup();
+  const res = ctx.onStudioRunEOM(event('September 2026'));
+  const out = outputs(res);
+  assert.equal(out.variables.status.stringValues[0], 'STARTED');
+  assert.match(out.log.textFormatElements[0].text, /Checks passed for September 2026/);
+  assert.equal(gas.services.triggers.length, 1, 'one background run queued');
+  assert.equal(gas.services.triggers[0].fn, 'runQueuedStudioBuild');
+  assert.equal(findFile(sep, 'DAIRYPILL_EOM COGS - September 2026'), null, 'nothing built yet — the step only checks');
+
+  ctx.runQueuedStudioBuild({});
+  assert.ok(findFile(sep, 'DAIRYPILL_EOM COGS - September 2026'), 'workbook built by the background run');
+  assert.equal(gas.services.mail.length, 1);
+  const mail = gas.services.mail[0];
+  assert.equal(mail.to, 'tester@example.com');
+  assert.match(mail.subject, /EOM workbook — September 2026 — ready/);
+  assert.match(mail.body, /https:\/\/docs\.google\.com\/spreadsheets\/d\//);
+  assert.match(mail.body, /Checks tab/);
+  assert.deepEqual(gas.services.triggers, [], 'trigger removed');
+  assert.equal(gas.services.props.STUDIO_JOB, undefined, 'job cleared');
+});
+
+test('a second run while one is building is refused (retryable), nothing double-queued', () => {
+  const { gas, ctx } = setup();
+  outputs(ctx.onStudioRunEOM(event('September 2026')));
+  const err = error(ctx.onStudioRunEOM(event('September 2026')));
+  assert.equal(err.retryability, 'RETRYABLE');
+  assert.match(err.errorLog.textFormatElements[0].text, /already running/);
+  assert.equal(gas.services.triggers.length, 1);
+});
+
+test('a stale job (older than 30 min) does not block a new run', () => {
+  const { gas, ctx } = setup();
+  gas.services.props.STUDIO_JOB = JSON.stringify({ kind: 'EOM', month: 'August 2026', queuedAt: Date.now() - 31 * 60 * 1000 });
+  assert.equal(outputs(ctx.onStudioRunEOM(event('September 2026'))).variables.status.stringValues[0], 'STARTED');
+});
+
+test('problems found by the checks show in Studio in plain English, and nothing is queued', () => {
+  const { gas, ctx } = setup();
+  let err = error(ctx.onStudioRunEOM(event('October 2026')));
+  assert.equal(err.retryability, 'NOT_RETRYABLE');
+  assert.equal(err.errorActionability, 'ACTIONABLE');
+  assert.match(err.errorLog.textFormatElements[0].text, /No folder named "October 2026" inside "EOM Reports"/);
+
+  err = error(ctx.onStudioRunEOM(event('Sept 2026')));
+  assert.match(err.errorLog.textFormatElements[0].text, /must look like "September 2026"/);
+
+  const { gas: g2, ctx: c2, sep } = setup();
+  const it = sep.getFilesByName('orders_export.csv'); it.next().trashed = true;
+  err = error(c2.onStudioRunEOM(event('September 2026')));
+  assert.match(err.errorLog.textFormatElements[0].text, /missing: Shopify/i);
+
+  assert.deepEqual(gas.services.triggers, []);
+  assert.deepEqual(g2.services.triggers, []);
+  assert.equal(gas.services.props.STUDIO_JOB, undefined);
+});
+
+test('a build that fails in the background emails the problem', () => {
+  const { gas, ctx, sep } = setup();
+  // Passes the quick checks, but the ledger is missing the 1st — caught by the full build.
+  const led = findFile(sep, '177349020748.csv');
+  const raw = sampleRaw(2026, 8);
+  led.content = csv(raw.ledger.filter((r) => !String(r[0]).startsWith('09/01/')));
+  outputs(ctx.onStudioRunEOM(event('September 2026')));
+  ctx.runQueuedStudioBuild({});
+  const mail = gas.services.mail[0];
+  assert.match(mail.subject, /FAILED/);
+  assert.match(mail.body, /was NOT built[\s\S]*missing 1 day\(s\): 09\/01\/2026[\s\S]*run the flow again/);
+  assert.equal(gas.services.props.STUDIO_JOB, undefined, 'job cleared even after a failure');
+});
+
+test('if background runs are not allowed, the step builds right away and reports DONE', () => {
+  const { gas, ctx, sep } = setup();
+  gas.services.triggersBlocked = true;
+  const out = outputs(ctx.onStudioRunEOM(event('September 2026')));
+  assert.equal(out.variables.status.stringValues[0], 'DONE');
+  assert.ok(findFile(sep, 'DAIRYPILL_EOM COGS - September 2026'));
+  assert.equal(gas.services.props.STUDIO_JOB, undefined);
+});
+
+test('Build DairyPill Shopify Sell Thru only needs the Shopify export', () => {
+  const { gas, ctx, sep } = setup();
+  findFile(sep, 'BusinessReport.csv').trashed = true; // not needed for Sell Thru
+  const out = outputs(ctx.onStudioRunShopify(event('September 2026')));
+  assert.match(out.log.textFormatElements[0].text, /Shopify Sell Thru file/);
+  ctx.runQueuedStudioBuild({});
+  assert.ok(findFile(sep, 'DairyPill Sell Thru Sep 2026'));
+  assert.match(gas.services.mail[0].subject, /Shopify Sell Thru file — September 2026 — ready/);
+});
+
+test('blank month means last calendar month (Rule 1.2)', () => {
+  const { ctx } = setup();
+  const now = new Date();
+  const expected = ctx.resolveMonth_('', now).label;
+  const err = error(ctx.onStudioRunEOM(event(undefined)));
+  assert.match(err.errorLog.textFormatElements[0].text, new RegExp('No folder named "' + expected + '"'));
+});
+
+test('config card: one Month box that accepts starter variables and shows the saved value', () => {
+  const { ctx } = setup();
+  const res = ctx.onStudioConfigEOM({ workflow: { elementConfiguration: { inputs: { month: { stringValues: ['October 2026'] } } } } });
+  const card = res.action.navigations[0].pushCard;
+  const input = card.sections[0].widgets.find((w) => w.textInput).textInput;
+  assert.equal(input.name, 'month');
+  assert.equal(input.value, 'October 2026');
+  assert.equal(input.hostAppDataSource.workflowDataSource.includeVariables, true);
+  assert.equal(ctx.onStudioConfigShopify({}).action.navigations[0].pushCard.sections[0].header, 'Build DairyPill Shopify Sell Thru');
+});
+
+test('appsscript.json: every Studio step points at real functions and uses the "month" input', () => {
+  const { ctx } = setup();
+  const man = JSON.parse(fs.readFileSync(path.join(__dirname, '..', 'appsscript.json'), 'utf8'));
+  const steps = man.addOns.flows.workflowElements;
+  assert.equal(steps.length, 2);
+  for (const s of steps) {
+    assert.equal(typeof ctx[s.workflowAction.onConfigFunction], 'function', s.workflowAction.onConfigFunction);
+    assert.equal(typeof ctx[s.workflowAction.onExecuteFunction], 'function', s.workflowAction.onExecuteFunction);
+    assert.deepEqual(s.workflowAction.inputs.map((i) => i.id), ['month']);
+    assert.deepEqual(s.workflowAction.outputs.map((o) => o.id), ['status', 'message']);
+  }
+  assert.equal(typeof ctx.runQueuedStudioBuild, 'function', 'trigger target exists');
+});
